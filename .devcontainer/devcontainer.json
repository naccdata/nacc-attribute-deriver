// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
    //"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
    // need to build manually due to yarn gpg issue described in
    // https://github.com/devcontainers/features/issues/1543
    "build": {
        "dockerfile": "Dockerfile"
    },

    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:4": {
            "version": "latest",
            "enableNonRootDocker": true,
            "moby": false
        },
        "ghcr.io/devcontainers/features/go:1": {}
    },
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:/home/vscode/bin"
    },

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "bash ./.devcontainer/post_create_command.sh ${containerWorkspaceFolder}",

	// Configure tool-specific properties.
	"customizations": {
        "vscode": {
            "settings": {
                "dev.containers.dockerCredentialHelper": false,
                "editor.detectIndentation": false
            },
            "extensions": [
                "ms-python.python",
                "ms-azuretools.vscode-docker",
                "streetsidesoftware.code-spell-checker",                
                "yzhang.markdown-all-in-one",
                "charliermarsh.ruff"
            ]
        }
    }

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
